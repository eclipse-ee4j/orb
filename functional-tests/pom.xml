<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.glassfish.corba</groupId>
        <artifactId>glassfish-corba</artifactId>
        <version>5.0.3-SNAPSHOT</version>
    </parent>

    <artifactId>glassfish-corba-tests</artifactId>
    <packaging>jar</packaging>

    <name>Functional Tests</name>

    <properties>
        <debug.args>-Ddebug=ignored</debug.args>
        
        <!-- working directory for the suite. target/ itself, because Surefire does not create
             workingDirectory and it must exist before the fork starts; run output lands in
             target/gen, so mvn clean still removes it. -->
        <functional.tests.rundir>${project.build.directory}</functional.tests.rundir>
        
        <!-- Functional test failures fail the build. This was the second defect motivating the
             migration: the Ant <java> that ran the suite set neither failonerror nor
             resultproperty, so a failing suite still produced a green build. Override on the
             command line with -Dfunctional.tests.failureIgnore=true when iterating locally. -->
        <functional.tests.failureIgnore>false</functional.tests.failureIgnore>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.glassfish.gmbal</groupId>
            <artifactId>gmbal-api-only</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.gmbal</groupId>
            <artifactId>gmbal</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>glassfish-corba-csiv2-idl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>idlj</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>glassfish-corba-omgapi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>glassfish-corba-orb</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>rmic</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.pfl</groupId>
            <artifactId>pfl-basic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.pfl</groupId>
            <artifactId>pfl-basic-tools</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.pfl</groupId>
            <artifactId>pfl-dynamic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.pfl</groupId>
            <artifactId>pfl-tf</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.pfl</groupId>
            <artifactId>pfl-tf-tools</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.pfl</groupId>
            <artifactId>pfl-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.external</groupId>
            <artifactId>management-api</artifactId>
            <version>3.3.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.12.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- generate test idl -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>idlj-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate-test</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includeDirs>
                        <includeDir>../omgapi/src/main/idl</includeDir>
                        <includeDir>../omgapi/src/main/idl-includes</includeDir>
                    </includeDirs>
                    <sources>
                        <source>
                            <compatible>true</compatible>
                            <includes>
                                <include>legacy/**/*.idl</include>
                            </includes>
                            <packagePrefixes>
                                <packagePrefix><type>activation</type><prefix>com.sun.corba.ee.spi</prefix></packagePrefix>
                            </packagePrefixes>
                        </source>
                        <source>
                            <packagePrefixes>
                                <packagePrefix><type>IOP</type>                <prefix>org.omg</prefix></packagePrefix>
                                <packagePrefix><type>Messaging</type>          <prefix>org.omg</prefix></packagePrefix>
                                <packagePrefix><type>PortableServer</type>     <prefix>org.omg</prefix></packagePrefix>
                                <packagePrefix><type>PortableInterceptor</type><prefix>org.omg</prefix></packagePrefix>
                            </packagePrefixes>
                            <compatible>false</compatible>
                            <defines>
                                <define>
                                    <symbol>CORBA3</symbol>
                                </define>
                            </defines>
                            <additionalArguments>
                                <additionalArgument>-corba</additionalArgument>
                                <additionalArgument>3.0</additionalArgument>
                            </additionalArguments>
                            <excludes>
                                <exclude>legacy/**</exclude>
                            </excludes>
                         </source>
                    </sources>
                </configuration>
            </plugin>

            <!--
                Re-declare the IDL output as a test source root, purely for the IDE's benefit.

                idlj:generate-test already registers target/generated-test-sources/idl with Maven
                itself, so the command-line build does not need this - MavenProject de-duplicates
                the path and the compiled output is unchanged. Eclipse, however, has no m2e
                connector for idlj-maven-plugin: it never runs the goal, so it never learns about
                the root, and all 713 generated sources are invisible to it. Every test that
                imports an IDL-generated type (WombatStuff, CodeSetTester, HelloStuff, ...) then
                shows unresolved imports even though the Maven build is clean.

                build-helper IS understood by m2e, so declaring the same root through it puts the
                generated sources on the IDE build path.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-generated-idl-test-source</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-test-sources/idl</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Generate rmic stubs -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>rmic-maven-plugin</artifactId>
                <configuration>
                    <testOutputDirectory>${project.build.testOutputDirectory}</testOutputDirectory>
                    <sources>
                        <source>
                            <iiop>true</iiop>
                            <poa>true</poa>
                            <keep>true</keep>
                            <includes>
                                <include>**/rmiiIServantPOA.class</include>
                                <include>**/corba/preinvokepostinvoke/MyServant.class</include>
                                <include>**/corba/rmipoacounter/counterImpl.class</include>
                            </includes>
                            <!-- corba.acceptorandcontactinfo also has an rmiiIServantPOA, but has
                                 never had a statically generated tie: its sources used to compile
                                 after rmic, so the class simply did not exist yet when rmic ran.
                                 Its Server names the tie as a string and lets the ORB generate one
                                 dynamically (ORBUseDynamicStub=true). Merging the trees made the
                                 class visible to rmic for the first time; excluding it keeps
                                 rmic's input set - and that test's runtime behaviour - unchanged.
                                 Remove this only as a deliberate, separately verified change. -->
                            <excludes>
                                <exclude>**/corba/acceptorandcontactinfo/**</exclude>
                            </excludes>
                        </source>
                        <source>
                            <keep>true</keep>
                            <iiop>true</iiop>
                            <includes>
                                <include>**/rmiiIServant.class</include>
                            </includes>
                        </source>
                    </sources>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.glassfish.corba</groupId>
                        <artifactId>rmic</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Compile tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!--
                    Test compilation happens in two strata separated by code generation, not in
                    one pass. The order below is required, not incidental:

                      test-compile          compiler:testCompile   src/test/java
                      process-test-classes  rmic:test-rmic         generate RMI-IIOP stubs/ties
                                            compiler:testCompile   the two rmic consumers
                                            compiler:testCompile   values1
                                            compiler:testCompile   values2

                    DO NOT move test-compile-post-rmic above the rmic plugin. Both run in
                    process-test-classes, Maven executes same-phase goals in POM declaration
                    order, and those two sources have compile-time references to classes rmic
                    generates. Equally, do not fold them back into default-testCompile, or add
                    them via build-helper:add-test-source: either puts them before rmic and the
                    build fails with "cannot find symbol".
                -->
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <!-- Carried over verbatim from the Ant compile-tests-main-nongen
                                 target when the pre-Maven tree was merged into src/test/java.
                                 These are compiled by the tests themselves at run time, or are
                                 deliberately broken/duplicate variants. Kept exactly as-is
                                 (wildcards included) so the move changed no semantics; they
                                 match nothing outside the merged-in tree. The last two are the
                                 rmic consumers, compiled by test-compile-post-rmic below. -->
                            <testExcludes>
                                <testExclude>corba/strm2/class*/**</testExclude>
                                <testExclude>corba/example/Client.java</testExclude>
                                <testExclude>corba/example/Server.java</testExclude>
                                <testExclude>hopper/h4549085/Server.java</testExclude>
                                <testExclude>hopper/h4549085/Client.java</testExclude>
                                <testExclude>hopper/h4620926/Server.java</testExclude>
                                <testExclude>hopper/h4620926/Client.java</testExclude>
                                <testExclude>hopper/h4670827/HelloImpl.java</testExclude>
                                <testExclude>hopper/h4670827/Client.java</testExclude>
                                <testExclude>hopper/h4670827/INSServer.java</testExclude>
                                <testExclude>hopper/h4670827/TestConstants.java</testExclude>
                                <testExclude>naming/pcosnaming/hello*</testExclude>
                                <testExclude>naming/instest/Client.java*</testExclude>
                                <testExclude>naming/instest/INSServer.java</testExclude>
                                <testExclude>naming/instest/HelloImpl.java</testExclude>
                                <testExclude>corba/preinvokepostinvoke/Server.java</testExclude>
                                <testExclude>corba/rmipoacounter/counterServer.java</testExclude>
                            </testExcludes>
                        </configuration>
                    </execution>

                    <!-- The only two test sources with a compile-time dependency on rmic output:
                         corba/preinvokepostinvoke/Server -> new _Interface_Stub()
                         corba/rmipoacounter/counterServer -> new _counterImpl_Tie()
                         They use the ordinary src/test/java root - target/test-classes is already
                         on the classpath here, so the generated ties resolve. -->
                    <execution>
                        <id>test-compile-post-rmic</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <testIncludes>
                                <testInclude>corba/preinvokepostinvoke/Server.java</testInclude>
                                <testInclude>corba/rmipoacounter/counterServer.java</testInclude>
                            </testIncludes>
                        </configuration>
                    </execution>

                    <!-- values1 and values2 declare the SAME fully qualified classes with
                         different bodies, to exercise class evolution. They cannot share an
                         output directory with each other or with the main tree, which is why
                         they sit outside src/test/java rather than merely being excluded from
                         it. values1 goes on the runtime classpath; values2 is served over HTTP
                         as the RMI codebase. Bound after test-compile because values1 imports
                         from the main tree. -->
                    <execution>
                        <id>test-compile-values1</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/test/values1</compileSourceRoot>
                            </compileSourceRoots>
                            <outputDirectory>${project.build.directory}/test/values1/classes</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-compile-values2</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/test/values2</compileSourceRoot>
                            </compileSourceRoots>
                            <outputDirectory>${project.build.directory}/test/values2/classes</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                The test sources have non-Java companions sitting beside them in src/test/java -
                .tdesc suite descriptors, .javaref/.idlref/.classlist expected-output files,
                test.policy - and the harness reads them TWO different ways: some from the
                classpath (Test.getResource -> getResourceAsStream), others from the filesystem
                via corba.test.srcdir (the .idl/.sjava it compiles at run time). Copying satisfies
                the first while the originals stay in place for the second.

                Deliberately copy-resources rather than declaring src/test/java as a
                <testResource>: a testResource would give one directory two identities in the
                Maven project model, source root AND resource root, and m2e stamps excluding="**"
                on resource directories - which would undo the very thing this layout exists to
                achieve. copy-resources takes its resource list from plugin configuration instead
                of project.build.testResources, so the model keeps src/test/java as a test source
                root and nothing else.
            -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-test-source-companions</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/test/java</directory>
                                    <excludes>
                                        <exclude>**/*.java</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                This module builds test classes only - it has no src/main and publishes nothing.
                packaging is jar rather than pom purely so IDEs give it a Java nature and treat
                src/test/java as a real source folder (m2e adds org.eclipse.jdt.core.javanature
                only for jar-ish packaging; under pom the module shows up as a plain folder with
                no classpath, no dependencies and no compile errors).

                That means the jar lifecycle's default bindings have to be switched back off,
                otherwise packaging=jar would change behaviour as a side effect of an IDE fix.
            -->

            <!-- Unbind default-test. The suite runs from the all-tests profile below; leaving
                 this bound would run tests during a plain `mvn install`, and it resolves its
                 provider independently - it picks surefire-testng, because TestNG is on the test
                 classpath for the harness's own use. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- Build no artifact and install nothing. There is no src/main to package, and this
                 module has never been published; jar packaging would otherwise add a new
                 published artifact to every release. The parent's maven-jar-plugin also points
                 <manifestFile> at output generated by maven-bundle-plugin, which this module
                 does not run. install must be skipped together with the unbinding above: without
                 a packaged file, install fails. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <profile>
            <id>all-tests</id>
            <build>
                <plugins>
                    <!--
                        Surefire runs the functional suite. These executions are bound explicitly
                        rather than configuring the lifecycle's default-test (which is unbound in
                        the base build), because the two kinds of test need different environments
                        and default-test is a single execution. They live in this profile so that a
                        plain `mvn install` still only compiles - the same split the Ant build had.

                        Two executions, because the two kinds of test need different environments:
                          tdesc-suites       - go through test.Test, which allocates its own ports
                          direct-junit-tests - do not, so they keep the properties Ant handed them
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <!--
                            Pin the JUnit 4 provider. TestNG is on this module's test classpath
                            because the legacy harness drives TestNG from inside its forked client
                            processes, and Surefire's auto-detection picks the TestNG provider on
                            that basis - which would run these JUnit 4 classes under the wrong
                            runner. The tests Surefire itself discovers here are all JUnit 4.
                        -->
                        <dependencies>
                            <dependency>
                                <groupId>org.apache.maven.surefire</groupId>
                                <artifactId>surefire-junit47</artifactId>
                                <version>${maven-surefire-plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!-- One fresh JVM per test class, sequentially. For the adapters that
                                 means one JVM per .tdesc, matching `java test.Test -file x.tdesc`;
                                 entries within a file share it, as they always did. The harness
                                 keeps static state in corba.framework.Options and uses fixed
                                 ports, so this must not be parallelised. -->
                            <forkCount>1</forkCount>
                            <reuseForks>false</reuseForks>
                            <parallel>none</parallel>
                            <!-- the defect this migration exists to fix: never pass silently
                                 because nothing ran -->
                            <failIfNoTests>true</failIfNoTests>
                            <!-- the harness passes System.getProperty("java.class.path") to the
                                 ORBD/server/client JVMs it forks; Surefire's default manifest-only
                                 launcher jar would give them a classpath of one jar -->
                            <useManifestOnlyJar>false</useManifestOnlyJar>
                            <workingDirectory>${functional.tests.rundir}</workingDirectory>
                            <argLine>-Xmx200m ${debug.args}</argLine>
                            <testFailureIgnore>${functional.tests.failureIgnore}</testFailureIgnore>
                        </configuration>
                        <executions>
                            <execution>
                                <id>tdesc-suites</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>test/suites/*TdescSuiteTest.java</include>
                                    </includes>
                                    <additionalClasspathElements>
                                        <additionalClasspathElement>${project.build.directory}/test/values1/classes</additionalClasspathElement>
                                        <additionalClasspathElement>${functional.tests.rundir}/gen</additionalClasspathElement>
                                    </additionalClasspathElements>
                                    <systemPropertyVariables>
                                        <javax.rmi.CORBA.UtilClass>com.sun.corba.ee.impl.javax.rmi.CORBA.Util</javax.rmi.CORBA.UtilClass>
                                        <javax.rmi.CORBA.StubClass>com.sun.corba.ee.impl.javax.rmi.CORBA.StubDelegateImpl</javax.rmi.CORBA.StubClass>
                                        <javax.rmi.CORBA.PortableRemoteObjectClass>com.sun.corba.ee.impl.javax.rmi.PortableRemoteObject</javax.rmi.CORBA.PortableRemoteObjectClass>
                                        <org.omg.CORBA.ORBClass>com.sun.corba.ee.impl.orb.ORBImpl</org.omg.CORBA.ORBClass>
                                        <org.omg.CORBA.ORBSingletonClass>com.sun.corba.ee.impl.orb.ORBSingleton</org.omg.CORBA.ORBSingletonClass>
                                        <java.naming.factory.state>com.sun.corba.ee.impl.presentation.rmi.JNDIStateFactoryImpl</java.naming.factory.state>
                                        <org.glassfish.gmbal.no.multipleUpperBoundsException>true</org.glassfish.gmbal.no.multipleUpperBoundsException>
                                        <com.sun.corba.ee.POA.ORBServerId>1</com.sun.corba.ee.POA.ORBServerId>
                                        <com.sun.corba.ee.ORBBase>${project.basedir}</com.sun.corba.ee.ORBBase>
                                        <com.sun.corba.ee.ORBUseDynamicStub>true</com.sun.corba.ee.ORBUseDynamicStub>
                                        <com.sun.corba.ee.ORBUseCodegenReflectiveCopyobject>false</com.sun.corba.ee.ORBUseCodegenReflectiveCopyobject>
                                        <com.sun.corba.ee.encoding.ORBEnableJavaSerialization>false</com.sun.corba.ee.encoding.ORBEnableJavaSerialization>
                                        <com.sun.corba.ee.ORBDebugForkedProcess>false</com.sun.corba.ee.ORBDebugForkedProcess>
                                        <com.sun.corba.ee.ORBDebugStubGeneration>false</com.sun.corba.ee.ORBDebugStubGeneration>
                                        <!-- lets the harness find each test's own sources without
                                             depending on the process working directory -->
                                        <corba.test.srcdir>${project.basedir}/src/test/java</corba.test.srcdir>
                                        <http.server.root.directory>${project.build.directory}/test/values2/classes</http.server.root.directory>
                                        <java.security.policy>${project.basedir}/src/test/java/test.policy</java.security.policy>
                                        <junit.report.dir>${project.build.directory}/junitreports</junit.report.dir>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>

                            <!-- These two are plain JUnit classes that Ant ran through its <junit>
                                 task, not through test.Test. They therefore never get
                                 Test.initRuntimeProperties, so they keep the explicit port and
                                 policy properties Ant gave them. Paths are absolute because the
                                 working directory is no longer test/run. -->
                            <execution>
                                <id>direct-junit-tests</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>corba/misc/Client.java</include>
                                        <include>corba/dynamicrmiiiop/Client.java</include>
                                    </includes>
                                    <additionalClasspathElements>
                                        <additionalClasspathElement>${project.build.directory}/test/values1/classes</additionalClasspathElement>
                                        <additionalClasspathElement>${functional.tests.rundir}/gen</additionalClasspathElement>
                                    </additionalClasspathElements>
                                    <systemPropertyVariables>
                                        <javax.rmi.CORBA.UtilClass>com.sun.corba.ee.impl.javax.rmi.CORBA.Util</javax.rmi.CORBA.UtilClass>
                                        <javax.rmi.CORBA.StubClass>com.sun.corba.ee.impl.javax.rmi.CORBA.StubDelegateImpl</javax.rmi.CORBA.StubClass>
                                        <javax.rmi.CORBA.PortableRemoteObjectClass>com.sun.corba.ee.impl.javax.rmi.PortableRemoteObject</javax.rmi.CORBA.PortableRemoteObjectClass>
                                        <org.omg.CORBA.ORBClass>com.sun.corba.ee.impl.orb.ORBImpl</org.omg.CORBA.ORBClass>
                                        <org.omg.CORBA.ORBSingletonClass>com.sun.corba.ee.impl.orb.ORBSingleton</org.omg.CORBA.ORBSingletonClass>
                                        <java.naming.factory.state>com.sun.corba.ee.impl.presentation.rmi.JNDIStateFactoryImpl</java.naming.factory.state>
                                        <org.glassfish.gmbal.no.multipleUpperBoundsException>true</org.glassfish.gmbal.no.multipleUpperBoundsException>
