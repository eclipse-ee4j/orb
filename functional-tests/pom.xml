<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.glassfish.corba</groupId>
        <artifactId>glassfish-corba</artifactId>
        <version>5.0.3-SNAPSHOT</version>
    </parent>

    <artifactId>glassfish-corba-tests</artifactId>
    <name>Functional Tests</name>
    <packaging>pom</packaging>

    <properties>
        <debug.args>-Ddebug=ignored</debug.args>
        <!-- The pre-Maven test tree. Still compiled in place rather than moved, because tests
             locate their own sources relative to it at run time (corba.test.srcdir), and the
             .tdesc files reference it by relative path. -->
        <legacy.test.src.dir>${project.basedir}/../test/src/share/classes</legacy.test.src.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.glassfish.gmbal</groupId>
            <artifactId>gmbal-api-only</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.gmbal</groupId>
            <artifactId>gmbal</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>glassfish-corba-csiv2-idl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>idlj</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>glassfish-corba-omgapi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>glassfish-corba-orb</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>rmic</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.pfl</groupId>
            <artifactId>pfl-basic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.pfl</groupId>
            <artifactId>pfl-basic-tools</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.pfl</groupId>
            <artifactId>pfl-dynamic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.pfl</groupId>
            <artifactId>pfl-tf</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.pfl</groupId>
            <artifactId>pfl-tf-tools</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.pfl</groupId>
            <artifactId>pfl-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.external</groupId>
            <artifactId>management-api</artifactId>
            <version>3.3.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.12.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
            </testResource>
            <!-- data files the harness loads via Class.getResource (.tdesc, .javaref,
                 .classlist, test.policy); the .java alongside them is compiled by the
                 test-compile-legacy execution instead -->
            <testResource>
                <directory>${legacy.test.src.dir}</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </testResource>
        </testResources>
        <plugins>
            <!-- generate test idl -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>idlj-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate-test</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includeDirs>
                        <includeDir>../omgapi/src/main/idl</includeDir>
                        <includeDir>../omgapi/src/main/idl-includes</includeDir>
                    </includeDirs>
                    <sources>
                        <source>
                            <compatible>true</compatible>
                            <includes>
                                <include>legacy/**/*.idl</include>
                            </includes>
                            <packagePrefixes>
                                <packagePrefix><type>activation</type><prefix>com.sun.corba.ee.spi</prefix></packagePrefix>
                            </packagePrefixes>
                        </source>
                        <source>
                            <packagePrefixes>
                                <packagePrefix><type>IOP</type>                <prefix>org.omg</prefix></packagePrefix>
                                <packagePrefix><type>Messaging</type>          <prefix>org.omg</prefix></packagePrefix>
                                <packagePrefix><type>PortableServer</type>     <prefix>org.omg</prefix></packagePrefix>
                                <packagePrefix><type>PortableInterceptor</type><prefix>org.omg</prefix></packagePrefix>
                            </packagePrefixes>
                            <compatible>false</compatible>
                            <defines>
                                <define>
                                    <symbol>CORBA3</symbol>
                                </define>
                            </defines>
                            <additionalArguments>
                                <additionalArgument>-corba</additionalArgument>
                                <additionalArgument>3.0</additionalArgument>
                            </additionalArguments>
                            <excludes>
                                <exclude>legacy/**</exclude>
                            </excludes>
                         </source>
                    </sources>
                </configuration>
            </plugin>

            <!-- generate rmic stubs -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>rmic-maven-plugin</artifactId>
                <configuration>
                    <testOutputDirectory>${project.build.testOutputDirectory}</testOutputDirectory>
                    <sources>
                        <source>
                            <iiop>true</iiop>
                            <poa>true</poa>
                            <keep>true</keep>
                            <includes>
                                <include>**/rmiiIServantPOA.class</include>
                                <include>**/corba/preinvokepostinvoke/MyServant.class</include>
                                <include>**/corba/rmipoacounter/counterImpl.class</include>
                            </includes>
                        </source>
                        <source>
                            <keep>true</keep>
                            <iiop>true</iiop>
                            <includes>
                                <include>**/rmiiIServant.class</include>
                            </includes>
                        </source>
                    </sources>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.glassfish.corba</groupId>
                        <artifactId>rmic</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- compile tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!--
                    Test compilation happens in two strata separated by code generation, not in
                    one pass. The order below is required, not incidental:

                      test-compile          compiler:testCompile   ordinary Maven test tree
                      process-test-classes  rmic:test-rmic         generate RMI-IIOP stubs/ties
                                            compiler:testCompile   legacy tree
                                            compiler:testCompile   values1
                                            compiler:testCompile   values2

                    The legacy tree must compile after rmic because two of its sources reference
                    generated ties (corba/preinvokepostinvoke/Server -> _Interface_Stub,
                    corba/rmipoacounter/counterServer -> _counterImpl_Tie). The old Ant build got
                    this ordering by accident, by compiling that tree at integration-time.

                    Maven runs goals bound to the same phase in POM declaration order, and the
                    rmic plugin is declared above this one, so the sequence holds. Do NOT move
                    test-compile-legacy to the test-compile phase, and do not fold the legacy
                    tree into the default execution via build-helper:add-test-source: either
                    puts it before rmic and the build fails with "cannot find symbol".
                -->
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>

                    <!-- The pre-Maven test tree, compiled into the same output directory so
                         there is a single set of test classes. It must run AFTER rmic: two of
                         its sources (corba/preinvokepostinvoke/Server, corba/rmipoacounter/
                         counterServer) reference rmic-generated ties. This mirrors the ordering
                         the Ant build had, where it compiled at integration-time. -->
                    <execution>
                        <id>test-compile-legacy</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${legacy.test.src.dir}</compileSourceRoot>
                            </compileSourceRoots>
                            <!-- Copied verbatim from the Ant compile-tests-main-nongen target.
                                 These are compiled by the tests themselves at run time, or are
                                 deliberately broken/duplicate variants. Kept exactly as-is
                                 (wildcards included) so this move changes no semantics. -->
                            <testExcludes>
                                <testExclude>values1/**</testExclude>
                                <testExclude>values2/**</testExclude>
                                <testExclude>corba/strm2/class*/**</testExclude>
                                <testExclude>corba/example/Client.java</testExclude>
                                <testExclude>corba/example/Server.java</testExclude>
                                <testExclude>hopper/h4549085/Server.java</testExclude>
                                <testExclude>hopper/h4549085/Client.java</testExclude>
                                <testExclude>hopper/h4620926/Server.java</testExclude>
                                <testExclude>hopper/h4620926/Client.java</testExclude>
                                <testExclude>hopper/h4670827/HelloImpl.java</testExclude>
                                <testExclude>hopper/h4670827/Client.java</testExclude>
                                <testExclude>hopper/h4670827/INSServer.java</testExclude>
                                <testExclude>hopper/h4670827/TestConstants.java</testExclude>
                                <testExclude>naming/pcosnaming/hello*</testExclude>
                                <testExclude>naming/instest/Client.java*</testExclude>
                                <testExclude>naming/instest/INSServer.java</testExclude>
                                <testExclude>naming/instest/HelloImpl.java</testExclude>
                            </testExcludes>
                        </configuration>
                    </execution>

                    <!-- values1 and values2 declare the SAME fully qualified classes with
                         different bodies, to exercise class evolution. They cannot share an
                         output directory with each other or with the main tree. values1 goes on
                         the runtime classpath; values2 is served over HTTP as the RMI codebase.
                         Bound after test-compile because values1 imports from the main tree. -->
                    <execution>
                        <id>test-compile-values1</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${legacy.test.src.dir}/values1</compileSourceRoot>
                            </compileSourceRoots>
                            <outputDirectory>${project.build.directory}/test/values1/classes</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-compile-values2</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${legacy.test.src.dir}/values2</compileSourceRoot>
                            </compileSourceRoots>
                            <outputDirectory>${project.build.directory}/test/values2/classes</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- packaging=pom binds no resource handling, but the legacy tree carries data files
                 the tests load from the classpath (.tdesc, .javaref, .classlist, test.policy). -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-resources</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>testResources</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <profile>
            <id>all-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>run-tests</id>
                                <phase>integration-test</phase>
                                <configuration>
                                    <target>
                                        <ant antfile="../make/build.xml" target="test-all">
                                            <property name="test-build.dir" value="${project.build.directory}/test" />
                                            <property name="root.dir" value=".." />
                                            <property name="maven.test.classpath" refid="maven.test.classpath" />
                                        </ant>
                                    </target>
                                </configuration>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>

        <profile>
            <id>test-with-args</id>
            <activation>
                <property>
                   <name>test.args</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>run-tests</id>
                                <phase>integration-test</phase>
                                <configuration>
                                    <target>
                                        <ant antfile="../make/build.xml" target="run-test-target-with-args">
                                            <property name="test-build.dir" value="${project.build.directory}/test" />
                                            <property name="root.dir" value=".." />
                                            <property name="maven.test.classpath" refid="maven.test.classpath" />
                                            <property name="test-args" value="${test.args}" />
                                        </ant>
                                    </target>
                                </configuration>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>add-debug-args</id>
            <activation>
                <property>
                   <name>debug.port</name>
                </property>
            </activation>
            <properties>
                <debug.args>-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=localhost:${debug.port}</debug.args>
            </properties>
        </profile>
    </profiles>
</project>
